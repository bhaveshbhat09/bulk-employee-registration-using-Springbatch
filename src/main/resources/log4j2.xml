<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Our own code: show everything from DEBUG up -->
        <Logger name="com.epfo.learn" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Everything else (Spring, Batch, DBCP): INFO and up -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>